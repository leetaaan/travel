rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Friends subcollection: cho phép chủ user hoặc friend ghi vào
      match /friends/{friendId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == friendId
        );
      }
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow update: if request.auth != null &&
        (resource.data.receiverId == request.auth.uid);

      allow create: if request.auth != null &&
        (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);

      allow delete: if false;
    }

    match /groups/{groupId} {
      // Allow read if the user is a member of the group
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // Allow create for any authenticated user
      allow create: if request.auth != null;
      // Allow update if:
      // - là creator, hoặc
      // - là user tự thêm mình vào members (tức là chỉ thêm đúng 1 người là mình)
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        (
          // Chỉ cho phép thêm đúng 1 thành viên là chính mình
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.members
        )
      );
    }

    match /groupInvitations/{invitationId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow update: if request.auth != null && resource.data.receiverId == request.auth.uid;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      // Allow read if the user is a member of the group
      allow read: if request.auth != null && exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members;

      // Allow create if the user is a member of the group
      allow create: if request.auth != null && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members &&
        request.resource.data.createdBy == request.auth.uid;

      // Allow update or delete if the user is the creator of the expense or the group leader
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (request.auth.uid == resource.data.createdBy ||
         request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.creatorId);
    }
  }
} 